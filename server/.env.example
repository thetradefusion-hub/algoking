NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/algoking?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Primary frontend URL (Vercel production)
CLIENT_URL=https://your-app.vercel.app

# Extra allowed origins (comma-separated), e.g. preview deployments
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Allow any *.vercel.app preview origin
ALLOW_VERCEL_PREVIEWS=true

# true when frontend and API are on different HTTPS domains
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

PLATFORM_MODE=DEMO
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
UPLOAD_DIR=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
PAYMENT_GATEWAY=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPER_ADMIN_EMAIL=admin@algoking.local
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_MOBILE=9999999999
SUPER_ADMIN_NAME=AlgoKing Super Admin
LOG_LEVEL=info
